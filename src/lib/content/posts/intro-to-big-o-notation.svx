  const logN = "O(\\log n)";
  const oN = "O(n)";
  const nLogN = "O(n \\log n)";
  const nSquared = "O(n^2)";
  const sqrtN = "O(\\sqrt{n})";
  const sieveTime = "O(n \\log \\log n)";
