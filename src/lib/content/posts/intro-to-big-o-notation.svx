  const theta = "\\Theta";

  // Definitions
  const bigODef = "0 \\le f(n) \\le C g(n) \\text{ for all } n \\ge n_0";
  const bigOmegaDef = "0 \\le C g(n) \\le f(n) \\text{ for all } n \\ge n_0";
  const bigThetaDef = "0 \\le C_2 g(n) \\le f(n) \\le C_1 g(n) \\text{ for all } n \\ge n_0";

